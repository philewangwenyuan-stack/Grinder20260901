<launch>
  <arg name="gui" default="true" />
  <arg name="paused" default="false" />
  <arg name="sim_speed" default="1.0" />
  <arg name="world_name" default="$(eval optenv('GRINDER_SIM_WORLD', find('grinder_gazebo') + '/worlds/factory_floor.world'))" />
  <arg name="visual_mesh" default="false" />
  <arg name="lidar_x" default="0.20" />
  <arg name="lidar_y" default="0.0" />
  <arg name="lidar_z" default="0.55" />
  <arg name="lidar_backend" default="gpu" />
  <arg name="gpu_ray_sample_offset" default="1" />
  <arg name="lidar_horizontal_samples" default="360" />
  <arg name="lidar_vertical_samples" default="20" />
  <!-- 虚拟雷达最大量程，单位 m，与顶层启动及 URDF 默认值保持一致。 -->
  <arg name="lidar_max_range" default="45.0" />
  <arg name="sensor_noise_config" default="$(find grinder_gazebo)/config/sensor_noise.yaml" />
  <arg name="x" default="0.0" />
  <arg name="y" default="0.0" />
  <arg name="yaw" default="0.0" />

  <!-- Resolve the RVT-derived world meshes in both devel and installed packages. -->
  <env name="GAZEBO_RESOURCE_PATH" value="$(find grinder_gazebo):$(optenv GAZEBO_RESOURCE_PATH /usr/share/gazebo-11)" />
  <env name="GAZEBO_MODEL_PATH" value="$(find grinder_gazebo)/scenes/huadu_factory_gazebo/models:$(optenv GAZEBO_MODEL_PATH)" />

  <param name="use_sim_time" value="true" />
  <param name="robot_description"
         command="$(find xacro)/xacro '$(find grinder_gazebo)/urdf/x920_grinder.urdf.xacro' gpu_ray_sample_offset:=$(arg gpu_ray_sample_offset) lidar_backend:=$(arg lidar_backend) visual_mesh:=$(arg visual_mesh) lidar_x:=$(arg lidar_x) lidar_y:=$(arg lidar_y) lidar_z:=$(arg lidar_z) lidar_horizontal_samples:=$(arg lidar_horizontal_samples) lidar_vertical_samples:=$(arg lidar_vertical_samples) lidar_max_range:=$(arg lidar_max_range) sensor_noise_config:=$(arg sensor_noise_config)" />

  <include file="$(find gazebo_ros)/launch/empty_world.launch">
    <arg name="world_name" value="$(arg world_name)" />
    <arg name="gui" value="$(arg gui)" />
    <arg name="paused" value="$(arg paused)" />
    <arg name="use_sim_time" value="true" />
  </include>

  <!-- One-shot service update preserves the chosen world's time step, gravity and ODE settings. -->
  <node pkg="grinder_gazebo" type="set_sim_speed.py" name="grinder_sim_speed" output="screen">
    <param name="speed" value="$(arg sim_speed)" />
  </node>

  <node pkg="robot_state_publisher" type="robot_state_publisher" name="robot_state_publisher" output="screen">
    <param name="publish_frequency" value="30.0" />
  </node>

  <node pkg="gazebo_ros" type="spawn_model" name="spawn_x920" output="screen"
        args="-urdf -param robot_description -model x920_grinder -x $(arg x) -y $(arg y) -z 0.1675 -Y $(arg yaw)" />
</launch>
