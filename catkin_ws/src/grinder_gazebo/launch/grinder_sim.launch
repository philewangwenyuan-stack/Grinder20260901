<launch>
  <arg name="scheduler_config" default="$(find grinder_scheduler)/config/scheduler.yaml" />
  <arg name="scheduler_local_config" default="$(optenv GRINDER_SCHEDULER_LOCAL_CONFIG)" />
  <arg name="gui" default="true" />
  <arg name="paused" default="false" />
  <arg name="visual_mesh" default="false" />
  <arg name="lidar_x" default="0.20" />
  <arg name="lidar_y" default="0.0" />
  <arg name="lidar_z" default="0.55" />
  <arg name="lidar_horizontal_samples" default="360" />
  <arg name="lidar_vertical_samples" default="20" />
  <!-- 虚拟雷达最大量程，单位 m；仅影响仿真，缩短射线查询范围以减轻 CPU 负担。 -->
  <arg name="lidar_max_range" default="45.0" />
  <arg name="sensor_noise_config" default="$(find grinder_gazebo)/config/sensor_noise.yaml" />
  <arg name="super_lio_map_root" default="$(find grinder_gazebo)/../../../maps/sim_mid360" />
  <arg name="start_navigation" default="true" />
  <arg name="navigation_local_planner" default="rpp" />
  <arg name="local_rtsp_enabled" default="true" />
  <arg name="sl_linka_port" default="8002" />
  <arg name="x" default="0.0" />
  <arg name="y" default="0.0" />
  <arg name="yaw" default="0.0" />

  <param name="use_sim_time" value="true" />

  <include file="$(find grinder_gazebo)/launch/spawn_x920.launch">
    <arg name="gui" value="$(arg gui)" />
    <arg name="paused" value="$(arg paused)" />
    <arg name="visual_mesh" value="$(arg visual_mesh)" />
    <arg name="lidar_x" value="$(arg lidar_x)" />
    <arg name="lidar_y" value="$(arg lidar_y)" />
    <arg name="lidar_z" value="$(arg lidar_z)" />
    <arg name="lidar_horizontal_samples" value="$(arg lidar_horizontal_samples)" />
    <arg name="lidar_vertical_samples" value="$(arg lidar_vertical_samples)" />
    <arg name="lidar_max_range" value="$(arg lidar_max_range)" />
    <arg name="sensor_noise_config" value="$(arg sensor_noise_config)" />
    <arg name="x" value="$(arg x)" />
    <arg name="y" value="$(arg y)" />
    <arg name="yaw" value="$(arg yaw)" />
  </include>

  <node pkg="grinder_gazebo" type="chassis_sim_node.py" name="grinder_chassis_sim" output="screen">
    <param name="wheel_track_m" value="0.70" />
    <param name="wheel_radius_m" value="0.1475" />
    <param name="gear_ratio" value="60.0" />
    <param name="max_motor_rpm" value="3000.0" />
    <!-- Same manual wheel direction mapping as chassis_driver.yaml. -->
    <param name="drive_left_sign" value="-1" />
    <param name="drive_right_sign" value="-1" />
    <param name="drive_swap_lr" value="false" />
    <param name="sim_drive_axis_sign" value="1" />
    <param name="command_timeout" value="0.5" />
    <param name="sim_command_topic" value="/grinder/sim/cmd_vel" />
    <param name="sim_odom_topic" value="/grinder/sim/ground_truth/odom" />
  </node>

  <include file="$(find grinder_gazebo)/launch/scheduler_sim.launch">
    <arg name="scheduler_config" value="$(arg scheduler_config)" />
    <arg name="scheduler_local_config" value="$(arg scheduler_local_config)" />
    <arg name="local_rtsp_enabled" value="$(arg local_rtsp_enabled)" />
    <arg name="sl_linka_port" value="$(arg sl_linka_port)" />
    <arg name="lidar_x" value="$(arg lidar_x)" />
    <arg name="lidar_y" value="$(arg lidar_y)" />
    <arg name="lidar_z" value="$(arg lidar_z)" />
    <arg name="super_lio_map_root" value="$(arg super_lio_map_root)" />
  </include>

  <include if="$(arg start_navigation)"
           file="$(find teb_local_planner_tutorials)/launch/robot_diff_drive.launch">
    <arg name="local_planner" value="$(arg navigation_local_planner)" />
    <arg name="use_sim_time" value="true" />
  </include>

  <!-- /scan is projected from the virtual MID-360S, not a second 2D sensor. -->
  <rosparam if="$(arg start_navigation)"
            command="load"
            file="$(find grinder_gazebo)/config/navigation_sim_overrides.yaml" />
</launch>
