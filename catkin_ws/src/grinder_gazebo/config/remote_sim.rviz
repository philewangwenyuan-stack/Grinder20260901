Panels:
  - Class: rviz/Displays
    Name: Displays
  - Class: rviz/Views
    Name: Views
Visualization Manager:
  Class: ""
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 15
  Displays:
    - Class: rviz/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Plane: XY
      Reference Frame: <Fixed Frame>
    - Class: rviz/Map
      Name: Map
      Enabled: true
      Topic: /map
      Alpha: 0.8
      Color Scheme: map
      Draw Behind: true
    - Class: rviz/RobotModel
      Name: Robot
      Enabled: true
      Robot Description: robot_description
      Visual Enabled: true
      Collision Enabled: false
      Alpha: 1
    - Class: rviz/Path
      Name: Planned path
      Enabled: true
      Topic: /grinder/GlobalPlanner/plan
      Color: 32; 220; 80
      Line Style: Lines
      Line Width: 0.03
    - Class: rviz/TF
      Name: TF
      Enabled: false
      Show Axes: true
      Show Names: true
    - Class: rviz/PointCloud2
      Name: LIO cloud
      Enabled: false
      Topic: /lio/map_cloud
      Style: Points
      Size (Pixels): 2
      Color Transformer: AxisColor
      Position Transformer: XYZ
      Queue Size: 1
  Tools:
    - Class: rviz/Interact
    - Class: rviz/MoveCamera
    - Class: rviz/Select
  Views:
    Current:
      Class: rviz/TopDownOrtho
      Name: Current View
      Target Frame: map
      Scale: 15
      X: 0
      Y: 0
Window Geometry:
  Width: 1200
  Height: 800
