<launch>
  <arg name="wheel_fusion_enabled" default="false" />
  <arg name="wheel_fuse_linear_velocity" default="true" />
  <arg name="wheel_fuse_angular_velocity" default="false" />
  <arg name="wheel_twist_topic" default="/chassis/wheel_twist" />
  <arg name="wheel_max_age_sec" default="0.25" />
  <arg name="wheel_single_nis_gate" default="9.0" />
  <arg name="wheel_joint_nis_gate" default="11.83" />
  <arg name="rviz" default="true"/>
  <arg name="base_to_laser_x" default="0.0" />
  <arg name="base_to_laser_y" default="0.0" />
  <arg name="base_to_laser_z" default="0.0" />
  <arg name="base_to_laser_roll" default="0.0" />
  <arg name="base_to_laser_pitch" default="0.0" />
  <arg name="base_to_laser_yaw" default="0.0" />
  <arg name="mapper_config" default="$(find cloud_to_occupancy_grid)/config/mid360.yaml"/>
  <arg name="save_3d_map" default="false"/>
  <arg name="loop_closure" default="true"/>
  <arg name="loop_backend" default="industrial"/>
  <arg name="map_directory" default="/data/maps/current"/>
  <arg name="map_name" default="grinder_map"/>
  <arg name="autosave" default="false"/>

  <!-- Start the Livox driver separately before this launch file. -->
  <include file="$(find super_lio)/launch/Livox_mid360.launch">
    <arg name="wheel_fusion_enabled" value="$(arg wheel_fusion_enabled)" />
    <arg name="wheel_fuse_linear_velocity" value="$(arg wheel_fuse_linear_velocity)" />
    <arg name="wheel_fuse_angular_velocity" value="$(arg wheel_fuse_angular_velocity)" />
    <arg name="wheel_twist_topic" value="$(arg wheel_twist_topic)" />
    <arg name="wheel_max_age_sec" value="$(arg wheel_max_age_sec)" />
    <arg name="wheel_single_nis_gate" value="$(arg wheel_single_nis_gate)" />
    <arg name="wheel_joint_nis_gate" value="$(arg wheel_joint_nis_gate)" />
    <arg name="rviz" value="false"/>
    <arg name="base_to_laser_x" value="$(arg base_to_laser_x)" />
    <arg name="base_to_laser_y" value="$(arg base_to_laser_y)" />
    <arg name="base_to_laser_z" value="$(arg base_to_laser_z)" />
    <arg name="base_to_laser_roll" value="$(arg base_to_laser_roll)" />
    <arg name="base_to_laser_pitch" value="$(arg base_to_laser_pitch)" />
    <arg name="base_to_laser_yaw" value="$(arg base_to_laser_yaw)" />
  </include>

  <!-- The 2D mapper owns persistent mapping in this mode. Disabling Super-LIO's
       cumulative PCD buffer prevents memory from growing with run time. -->
  <param name="/lio/map/save_map" value="$(arg save_3d_map)"/>
  <param name="/lio/output/dense" value="false"/>
  <param name="/lio/output/pub_step" value="2"/>

  <group if="$(arg loop_closure)">
    <include file="$(find super_lio_loop)/launch/loop_closure.launch">
      <arg name="backend" value="$(arg loop_backend)"/>
    </include>
    <include file="$(find cloud_to_occupancy_grid)/launch/mapper.launch">
      <arg name="config" value="$(arg mapper_config)"/>
      <arg name="cloud_topic" value="/lio/loop_cloud"/>
      <arg name="reprojection_enabled"
           value="$(eval arg('loop_backend') == 'industrial')"/>
      <arg name="map_directory" value="$(arg map_directory)"/>
      <arg name="map_name" value="$(arg map_name)"/>
      <arg name="autosave" value="$(arg autosave)"/>
    </include>
  </group>

  <group unless="$(arg loop_closure)">
    <node pkg="tf2_ros" type="static_transform_publisher"
          name="map_to_odom_identity"
          args="0 0 0 0 0 0 map odom"/>
    <include file="$(find cloud_to_occupancy_grid)/launch/mapper.launch">
      <arg name="config" value="$(arg mapper_config)"/>
      <arg name="cloud_topic" value="/lio/map_cloud"/>
      <arg name="reprojection_enabled" value="false"/>
      <arg name="map_directory" value="$(arg map_directory)"/>
      <arg name="map_name" value="$(arg map_name)"/>
      <arg name="autosave" value="$(arg autosave)"/>
    </include>
  </group>

  <group if="$(arg rviz)">
    <node pkg="rviz" type="rviz" name="mid360_mapping_rviz"
          args="-d $(find cloud_to_occupancy_grid)/rviz/mid360_mapping.rviz"/>
  </group>
</launch>
