<launch>
  <arg name="aurora_ip_address" default="192.168.0.114" />
  <arg name="aurora_raw_image_on" default="true" />
  <arg name="aurora_no_preview_image" default="false" />
  <arg name="navigation_map_yaml_path" default="$(find teb_local_planner_tutorials)/maps/map.yaml" />
  <arg name="local_rtsp_mediamtx_path" default="tools/mediamtx/mediamtx" />
  <arg name="map_topic" default="/map" />
  <arg name="odom_topic" default="/lio/odom" />
  <arg name="left_image_topic" default="/slamware_ros_sdk_server_node/left_image_raw" />
  <arg name="right_image_topic" default="/slamware_ros_sdk_server_node/right_image_raw" />
  <arg name="super_lio_map_root" default="/home/neardi/work/Grinder/maps" />
  <arg name="enable_metrics_node" default="false" />
  <arg name="metrics_export_enabled" default="true" />
  <arg name="metrics_export_dir" default="/tmp/grinder_metrics" />
  <arg name="metrics_export_interval_sec" default="10.0" />
  <arg name="sl_linka_rx_diagnostic_logging" default="false" />

  <!-- 可选系统采样节点：1 Hz 内存采样，后台每 10 秒写一次有界 JSON 快照。 -->
  <node if="$(arg enable_metrics_node)"
        pkg="grinder_scheduler"
        type="grinder_metrics_node.py"
        name="grinder_metrics"
        output="screen">
    <param name="metrics_export_dir" value="$(arg metrics_export_dir)" />
    <param name="metrics_export_interval_sec" value="$(arg metrics_export_interval_sec)" />
  </node>

  <node pkg="grinder_scheduler"
        type="super_lio_mode_manager.py"
        name="super_lio_mode_manager"
        output="screen">
    <rosparam command="load" file="$(find grinder_scheduler)/config/super_lio.yaml" />
    <param name="super_lio_map_root" value="$(arg super_lio_map_root)" />
    <param name="metrics_export_enabled" value="$(arg metrics_export_enabled)" />
    <param name="metrics_export_dir" value="$(arg metrics_export_dir)" />
    <param name="metrics_export_interval_sec" value="$(arg metrics_export_interval_sec)" />
  </node>

  <node pkg="grinder_scheduler"
        type="scheduler_node.py"
        name="grinder_scheduler"
        output="screen">
    <rosparam command="load" file="$(find grinder_scheduler)/config/scheduler.yaml" />
    <rosparam command="load" file="$(find grinder_scheduler)/config/super_lio.yaml" />
    <param name="aurora_ip_address" value="$(arg aurora_ip_address)" />
    <param name="aurora_raw_image_on" value="$(arg aurora_raw_image_on)" />
    <param name="aurora_no_preview_image" value="$(arg aurora_no_preview_image)" />
    <param name="navigation_map_yaml_path" value="$(arg navigation_map_yaml_path)" />
    <param name="local_rtsp_mediamtx_path" value="$(arg local_rtsp_mediamtx_path)" />
    <param name="map_topic" value="$(arg map_topic)" />
    <param name="odom_topic" value="$(arg odom_topic)" />
    <param name="left_image_topic" value="$(arg left_image_topic)" />
    <param name="right_image_topic" value="$(arg right_image_topic)" />
    <param name="localization_backend" value="super_lio" />
    <param name="super_lio_map_root" value="$(arg super_lio_map_root)" />
    <param name="metrics_export_enabled" value="$(arg metrics_export_enabled)" />
    <param name="metrics_export_dir" value="$(arg metrics_export_dir)" />
    <param name="metrics_export_interval_sec" value="$(arg metrics_export_interval_sec)" />
    <param name="sl_linka_rx_diagnostic_logging" value="$(arg sl_linka_rx_diagnostic_logging)" />
    <param name="live_map_align_to_initial_yaw" value="false" />
  </node>
</launch>
