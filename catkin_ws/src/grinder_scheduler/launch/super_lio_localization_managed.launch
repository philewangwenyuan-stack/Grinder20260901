<launch>
  <arg name="wheel_fusion_enabled" default="false" />
  <arg name="wheel_fuse_linear_velocity" default="true" />
  <arg name="wheel_fuse_angular_velocity" default="false" />
  <arg name="wheel_twist_topic" default="/chassis/wheel_twis" />
  <arg name="wheel_max_age_sec" default="0.25" />
  <arg name="wheel_single_nis_gate" default="9.0" />
  <arg name="wheel_joint_nis_gate" default="11.83" />
  <arg name="bundle_dir" />
  <arg name="base_to_laser_x" default="0.0" />
  <arg name="base_to_laser_y" default="0.0" />
  <arg name="base_to_laser_z" default="0.0" />
  <arg name="base_to_laser_roll" default="0.0" />
  <arg name="base_to_laser_pitch" default="0.0" />
  <arg name="base_to_laser_yaw" default="0.0" />

  <node pkg="map_server" type="map_server" name="map_server"
        args="$(arg bundle_dir)/map.yaml" output="screen" />
  <include file="$(find super_lio)/launch/relocation.launch">
    <arg name="wheel_fusion_enabled" value="$(arg wheel_fusion_enabled)" />
    <arg name="wheel_fuse_linear_velocity" value="$(arg wheel_fuse_linear_velocity)" />
    <arg name="wheel_fuse_angular_velocity" value="$(arg wheel_fuse_angular_velocity)" />
    <arg name="wheel_twist_topic" value="$(arg wheel_twist_topic)" />
    <arg name="wheel_max_age_sec" value="$(arg wheel_max_age_sec)" />
    <arg name="wheel_single_nis_gate" value="$(arg wheel_single_nis_gate)" />
    <arg name="wheel_joint_nis_gate" value="$(arg wheel_joint_nis_gate)" />
    <arg name="rviz" value="false" />
    <arg name="map_dir" value="$(arg bundle_dir)" />
    <arg name="map_name" value="loc_map.pcd" />
    <arg name="base_to_laser_x" value="$(arg base_to_laser_x)" />
    <arg name="base_to_laser_y" value="$(arg base_to_laser_y)" />
    <arg name="base_to_laser_z" value="$(arg base_to_laser_z)" />
    <arg name="base_to_laser_roll" value="$(arg base_to_laser_roll)" />
    <arg name="base_to_laser_pitch" value="$(arg base_to_laser_pitch)" />
    <arg name="base_to_laser_yaw" value="$(arg base_to_laser_yaw)" />
  </include>
</launch>

