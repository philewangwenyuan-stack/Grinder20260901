<?xml version="1.0"?>
<package format="2">
  <name>super_lio_loop</name>
  <version>0.1.0</version>
  <description>Industrial and bounded-memory fallback loop closure backends for Super-LIO.</description>
  <maintainer email="maintainer@example.com">Grinder Team</maintainer>
  <license>GPL-3.0</license>

  <buildtool_depend>catkin</buildtool_depend>
  <build_depend>message_generation</build_depend>
  <exec_depend>message_runtime</exec_depend>
  <depend>geometry_msgs</depend>
  <depend>diagnostic_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>pcl_conversions</depend>
  <depend>pcl_ros</depend>
  <depend>roscpp</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>visualization_msgs</depend>
  <!-- GTSAM 4.2 and fast_gicp are optional system/workspace dependencies.
       Their absence leaves the explicitly selected lightweight fallback buildable. -->
  <export/>
</package>
