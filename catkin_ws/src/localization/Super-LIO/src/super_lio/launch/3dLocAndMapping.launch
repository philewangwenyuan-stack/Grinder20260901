<launch>

  <arg name="rviz" default="true" />
  <arg name="relocation" default="false" />
  <arg name="mapping" default="false" />
  <arg name="binary_map" default="false" />
  <arg name="save_map_dir" default="super_lio_ws/src/Super-LIO/src/super_lio/map" />
  <arg name="map_name" default="loc_map.pcd" />


  <group if="$(arg mapping)">
    <rosparam file="$(find super_lio)/config/livox_360.yaml" command="load"/>

    <!-- Launch Nodes -->
    <node pkg="super_lio" type="super_lio_node" name="super_lio_node" output="log"/>

    <!-- Optional RViz -->
    <group if="$(arg rviz)">
            <node pkg="rviz" type="rviz" name="super_lio" args="-d $(find super_lio)/rviz/lio.rviz" />
    </group>
  </group>

  <group if="$(arg relocation)">
    <!-- Launch Nodes -->
    <node pkg="super_lio" type="relocation_node" name="relocation_node" output="screen">
      <rosparam file="$(find super_lio)/config/relocation.yaml" command="load"/>
      <param name="map/save_map_dir" value="$(arg save_map_dir)"/>
      <param name="map/map_name" value="$(arg map_name)"/>
    </node>

    <!-- Optional RViz -->
    <group if="$(arg rviz)">
            <node pkg="rviz" type="rviz" name="rviz" args="-d $(find super_lio)/rviz/relocation.rviz" />
    </group>
  </group>

  <group if="$(arg binary_map)">
    <arg name="file_directory" default="/home/hyq/hyq-ros-wrapper/super_lio_ws/src/Super-LIO/src/super_lio/map/"/>
    <arg name="file_name" default="plan_map"/>
    <arg name="map_topic_name" default="map"/>
    <arg name="min_height" default="0.5"/>
    <arg name="max_height" default="1.00"/>
    <arg name="radius" default="0.5"/>
    <arg name="neighbor_count" default="10"/>
    <arg name="resolution" default="0.1"/>

    <node pkg="pcd2pgm" name="pcd2pgm" type="pcd2pgm" output="screen">
      <param name="file_directory" value="$(arg file_directory)"/>
      <param name="file_name" value="$(arg file_name)"/>
      <param name="thre_z_min" value="$(arg min_height)"/>
      <param name="thre_z_max" value="$(arg max_height)"/>
      <param name="flag_pass_through" value="0"/>
      <param name="thre_radius" value="$(arg radius)"/>
      <param name="thres_point_count" value="$(arg neighbor_count)"/>
      <param name="map_resolution" value="$(arg resolution)"/>
      <param name="map_topic_name" value="$(arg map_topic_name)"/>
    </node>
  </group>


</launch>