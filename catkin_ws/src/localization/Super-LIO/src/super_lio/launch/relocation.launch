<launch>
  <arg name="scan_filter_livox_dust" default="true" />
  <arg name="wheel_fusion_enabled" default="false" />
  <arg name="wheel_fuse_linear_velocity" default="true" />
  <arg name="wheel_fuse_angular_velocity" default="false" />
  <arg name="wheel_twist_topic" default="/chassis/wheel_twist" />
  <arg name="wheel_max_age_sec" default="0.25" />
  <arg name="wheel_single_nis_gate" default="9.0" />
  <arg name="wheel_joint_nis_gate" default="11.83" />

  <arg name="rviz" default="true" />
  <arg name="map_dir" default="$(find super_lio)/map" />
  <arg name="map_name" default="map.pcd" />
  <!-- Measured base_link -> base_laser_link mounting transform. -->
  <arg name="base_to_laser_x" default="0.0" />
  <arg name="base_to_laser_y" default="0.0" />
  <arg name="base_to_laser_z" default="0.0" />
  <arg name="base_to_laser_roll" default="0.0" />
  <arg name="base_to_laser_pitch" default="0.0" />
  <arg name="base_to_laser_yaw" default="0.0" />

  <rosparam file="$(find super_lio)/config/relocation.yaml" command="load"/>
  <param name="/lio/extrinsic/base_to_laser_x" value="$(arg base_to_laser_x)" type="double" />
  <param name="/lio/extrinsic/base_to_laser_y" value="$(arg base_to_laser_y)" type="double" />
  <param name="/lio/extrinsic/base_to_laser_z" value="$(arg base_to_laser_z)" type="double" />
  <param name="/lio/extrinsic/base_to_laser_roll" value="$(arg base_to_laser_roll)" type="double" />
  <param name="/lio/extrinsic/base_to_laser_pitch" value="$(arg base_to_laser_pitch)" type="double" />
  <param name="/lio/extrinsic/base_to_laser_yaw" value="$(arg base_to_laser_yaw)" type="double" />
  <param name="/lio/map/save_map" value="false" />
  <param name="/lio/map/save_map_dir" value="$(arg map_dir)" />
  <param name="/lio/map/map_name" value="$(arg map_name)" />

  <param name="/lio/wheel/enabled" value="$(arg wheel_fusion_enabled)" />
  <param name="/lio/scan/filter_livox_dust" value="$(arg scan_filter_livox_dust)" type="bool" />
  <param name="/lio/wheel/mode" value="localization" />
  <param name="/lio/wheel/fuse_linear_velocity" value="$(arg wheel_fuse_linear_velocity)" />
  <param name="/lio/wheel/fuse_angular_velocity" value="$(arg wheel_fuse_angular_velocity)" />
  <param name="/lio/wheel/twist_topic" value="$(arg wheel_twist_topic)" />
  <param name="/lio/wheel/max_age_sec" value="$(arg wheel_max_age_sec)" />
  <param name="/lio/wheel/single_nis_gate" value="$(arg wheel_single_nis_gate)" />
  <param name="/lio/wheel/joint_nis_gate" value="$(arg wheel_joint_nis_gate)" />

  <!-- Launch Nodes -->
  <node pkg="super_lio" type="relocation_node" name="relocation_node" output="screen"/>

  <!-- Fixed-map relocation currently expresses its initialized pose directly in
       odom coordinates, so map and odom coincide unless a correction backend is used. -->
  <node pkg="tf2_ros" type="static_transform_publisher" name="map_to_odom_identity"
        args="0 0 0 0 0 0 map odom"/>
  <node pkg="tf2_ros" type="static_transform_publisher" name="base_to_laser"
        args="$(arg base_to_laser_x) $(arg base_to_laser_y) $(arg base_to_laser_z) $(arg base_to_laser_yaw) $(arg base_to_laser_pitch) $(arg base_to_laser_roll) base_link base_laser_link"/>

  <!-- Optional RViz -->
  <group if="$(arg rviz)">
		<node pkg="rviz" type="rviz" name="rviz" args="-d $(find super_lio)/rviz/relocation.rviz" />
	</group>
  
</launch>
